<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_iot_config_view_form" model="ir.ui.view">
        <field name="name">pos.iot.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="inside">
                <div class="row" invisible="not other_devices">
                    <label string="Debug Printer" for="debug_printer" class="col-lg-4 o_light_label"/>
                    <field name="debug_printer" placeholder="Debug Receipt Printer"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
